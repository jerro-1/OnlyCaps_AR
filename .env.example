# Copy this to .env and fill in real values. .env is gitignored -- nothing
# here should ever be committed with real secrets or personal contact info.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
VITE_ENCRYPTION_KEY=

# Shown to customers at checkout who to hand a Lalamove pickup off to.
# Optional: the app falls back to "OnlyCaps" / no phone shown if left blank.
VITE_LALAMOVE_CONTACT_NAME=
VITE_LALAMOVE_CONTACT_PHONE=
